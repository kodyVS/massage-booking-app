# =============================================================================
# Vital Touch Massage — environment variables
# Copy to `.env.local` for local dev. In production, set these in Vercel.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# MongoDB Atlas (or any Mongo) connection string. Used by `connectDB()`.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/virtual-touch?retryWrites=true&w=majority

# ---- NextAuth ---------------------------------------------------------------
# Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-32+-random-bytes
# Public origin of the app. Use http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# ---- Magic-link tokens ------------------------------------------------------
# Used by `tokens.service.ts` to sign manage-booking links and intake links.
# Generate with: `openssl rand -base64 32`
JWT_SECRET=replace-with-32+-random-bytes

# ---- SMS (Twilio) -----------------------------------------------------------
# Master kill-switch. When `false` the SMS service no-ops without calling Twilio.
# (Admin Settings has a second toggle; both must be true for SMS to fire.)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# E.164 format, e.g. +15551234567
TWILIO_FROM_NUMBER=+15551234567

# ---- Email (Resend) ---------------------------------------------------------
# Master kill-switch. When `false` the email service no-ops without calling Resend.
EMAIL_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be a verified sender on your Resend account.
RESEND_FROM_EMAIL=hello@vitaltouchmassage.com

# ---- Cloudflare Turnstile (bot protection on booking submit) ----------------
# Get keys at https://developers.cloudflare.com/turnstile/
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000

# ---- Upstash Redis (rate limiting on /api/holds and /api/bookings) ----------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ---- Business config --------------------------------------------------------
# IANA timezone identifier — all UTC times rendered in this zone.
BUSINESS_TIMEZONE=America/Edmonton

# ---- Cron --------------------------------------------------------------------
# Shared secret required by the /api/cron/reminders endpoint.
# Generate with: `openssl rand -base64 32`
CRON_SECRET=replace-with-32+-random-bytes
